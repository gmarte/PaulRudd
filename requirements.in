# Direct dependencies of the default (Claude) path. Edit this file or
# requirements-litellm.in, then regenerate both hash-locked files:
#
#   uv pip compile requirements.in requirements-litellm.in --universal \
#       --python-version 3.12 --generate-hashes -o requirements-litellm.lock
#   uv pip compile requirements.in --universal --python-version 3.12 \
#       --generate-hashes -c requirements-litellm.lock -o requirements.lock
#
# (The second command keeps every shared package at the same version, so
# installing LiteLLM on top of the core lock adds packages without changing any.)
#
# Pin SDKs exactly and upgrade deliberately, to releases that have been out for
# a while: LiteLLM 1.82.7 and 1.82.8 shipped a credential stealer.

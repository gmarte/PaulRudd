# Paul PR Review — Per-Repo Configuration
# Copy this file to .paul.yml in the root of your repository and customise it.
# All fields are optional — Paul uses sensible defaults for everything.
#
# Paul reads this file (and CLAUDE.md, README.md and .agents/rules/*.md) from the
# PR's base branch, so a PR can't change the rules it is reviewed by. A change to
# this file applies to reviews after it merges. To stop a PR from editing the
# workflow that runs Paul, see "Hardening the gate" in Paul's README.

# ── LLM Configuration ────────────────────────────────────────────────────────

# LLM provider: anthropic | openai | google
# Claude runs on the official Anthropic SDK. OpenAI and Gemini run through
# LiteLLM, which the action installs only when one of them is configured.
provider: anthropic

# Model to use. One model answers every call in a run, so the calls share one
# prompt cache.
# Anthropic examples:  claude-sonnet-5-5 | claude-opus-5-5 | claude-sonnet-4-6
# OpenAI examples:     gpt-4o | gpt-4o-mini
# Google examples:     gemini-2.5-pro | gemini-2.5-flash
#
# On models with structured outputs (Claude Sonnet 5.5 and Opus 5.5, for
# example) every answer follows Paul's JSON schema. On others, such as
# claude-sonnet-4-6, Paul reads the JSON tolerantly and asks once more when an
# answer is unusable.
model: claude-sonnet-5-5

# How hard the model works on each answer: low | medium | high | xhigh | max.
# Higher effort finds more and costs more. A level the model doesn't support
# isn't sent; "" leaves it to the model.
effort: medium

# Maximum tokens in each LLM response (max_output_tokens is accepted too).
# Capped at what the model can produce. Models that think before answering
# (Claude Sonnet 5 and Opus 5 or newer) count the thinking too, so Paul gives
# them at least 16000.
max_tokens: 16000

# Optional sampling temperature (0 = most deterministic; Claude accepts 0-1).
# Leave unset to use the model's default. It is never sent to models that
# reject it (Claude Opus 4.7+, Sonnet 5 and newer).
# temperature: 0

# Language for the review text (summaries, findings, fixes). Leave empty for English.
# language: Spanish

# Files reviewed at the same time (1-16). Lower it if your API key hits rate limits.
concurrency: 4

# ── Review Behaviour ──────────────────────────────────────────────────────────

# Minimum severity that fails the check.
# Options: critical | major | minor
# - "critical": only block for security/data-loss issues
# - "major":    also block for functional bugs and missing tests (recommended)
# - "minor":    block for any code quality issues
severity_threshold: major

# How sure Paul must be of a finding at or above the threshold for it to block:
# low | medium | high. Each finding has a severity (its impact if it is real)
# and a confidence (high: the code shown proves it; medium: very likely, on
# reasonable assumptions; low: it depends on code Paul can't see). Less certain
# findings are still shown, marked "not blocking".
min_confidence_to_block: medium

# What to do when a file with changes couldn't be reviewed (the LLM stayed
# unavailable, its response was cut off, the diff was too large for the GitHub
# API, or a time or cost budget ran out). The comment always lists those files.
# - "fail":    fail the check (recommended when Paul is a required check)
# - "neutral": pass the check with a warning, but only when the files couldn't
#              be reviewed because the LLM provider stayed unavailable. Files
#              left unreviewed for any other reason (too large, over a budget,
#              refused, unusable answers) still fail the check, since a PR's
#              author could cause those on purpose.
on_incomplete: fail

# What to do when a PR from a fork or Dependabot has no API key (they don't
# receive repository secrets). A missing key on any other PR always fails the
# check, since it usually means a misnamed secret.
# - "skip": pass the check with a notice
# - "fail": fail the check
forks: skip

# Paul stops after this many minutes and lists the files it didn't get to,
# which then count as not reviewed. Keep it below the job's timeout-minutes.
time_budget_minutes: 45

# ── Prompt Cache ─────────────────────────────────────────────────────────────

# Every call in a run starts with the same prefix: Paul's rules, this repo's
# guidelines and instructions, then the PR's description and diff. The first
# call writes it to the prompt cache and every later call reads it at a tenth
# of the input price.
cache:
  # How long Paul's rules and this repo's guidelines stay cached: 5m | 1h.
  # A 1h write costs 2x the input price (5m: 1.25x), but the next review in
  # this repo within the hour starts warm. The PR's own context always uses
  # 5m, since it changes on every push. (Claude only.)
  ttl: 5m

# ── Review Context ───────────────────────────────────────────────────────────

review:
  # How much of the PR's diff every call sees: auto | full | compact
  # - full:    every file's diff, so each file is reviewed knowing the whole PR
  # - compact: only each file's hunk headers; each call brings its own file's diff
  # - auto:    full when it fits in pr_context_max_tokens, compact otherwise
  diff_context: auto
  # Estimated token limit for the PR context in auto mode.
  pr_context_max_tokens: 80000

# ── Budgets ──────────────────────────────────────────────────────────────────

budget:
  # Files past this many aren't reviewed and are listed as not reviewed.
  max_files: 300
  # No new LLM call starts once the run's estimated cost reaches this many US
  # dollars; files Paul didn't get to are listed as not reviewed. Calls already
  # running finish, so a run can end a few calls over. Applies when Paul knows
  # the model's prices (the review details then show the cost).
  max_cost_usd: 5.0

# ── File Exclusions ───────────────────────────────────────────────────────────

# Patterns for files to skip entirely. They follow .gitignore rules: a pattern
# without a slash ("*.lock") matches at any depth, a pattern with a leading or
# middle slash ("docs/**") is anchored to the repo root, and "**/" matches any
# number of directories.
#
# Your patterns are added to the built-in defaults: lockfiles (*.lock,
# package-lock.json, npm-shrinkwrap.json, pnpm-lock.yaml, go.sum), dist/,
# build/, __pycache__/, *.pyc, *.min.js and *.min.css.
excluded_paths:
  # - "**/migrations/**"
  # - "docs/**"

# Set to false to drop the built-in defaults and use only the patterns above.
exclude_defaults: true

# ── Custom Instructions ───────────────────────────────────────────────────────

# Freeform text added to Paul's instructions, after the guideline files.
# Use this to describe your stack, architecture, and what Paul should focus on.
# Leave empty to use only the default review criteria.
custom_instructions: |
  This is a [describe your stack, e.g. "Python/FastAPI REST API with PostgreSQL"].
  Pay special attention to:
  - [Your critical concern #1, e.g. "SQL query safety — prefer the ORM over raw queries"]
  - [Your critical concern #2, e.g. "Authentication on every endpoint that touches user data"]
  - [Your critical concern #3, e.g. "Test coverage on business-logic changes"]
